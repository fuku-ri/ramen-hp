{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "men-dokoro-akari",
	"main": "src/worker.js",
	"compatibility_date": "2026-09-01",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*",
			"/media/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ramen-shop-db",
			"database_id": "36d4ea82-583a-480e-a5b9-8aa71dc1a7c7"
		}
	],
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "ramen-shop-images"
		}
	],
	"vars": {
		"SESSION_DAYS": "14"
	}
}