{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fukuri",
	"main": "src/worker.js",
	"compatibility_date": "2026-09-01",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*",
			"/media/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ramen-shop-db",
			"database_id": "36d4ea82-583a-480e-a5b9-8aa71dc1a7c7"
		}
	],
	"kv_namespaces": [
		{
			"binding": "IMAGES",
			"id": "927a58eec5564eea837cac68fe3ad9cd"
		}
	]
}